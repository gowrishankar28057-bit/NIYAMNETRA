# ---- NeyamNetra configuration (copy to .env and adjust) ----

# REQUIRED in production: a long random secret for signing demo session cookies.
SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave unset to use a local SQLite file (development only).
# For production use PostgreSQL 17, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/neyamnetra
DATABASE_URL=

# Demo mode. true => any non-empty login ID + password signs in (SIH demonstration).
# Set to false in production to reject arbitrary credentials (real auth is not bundled).
DEMO_MODE=true

# Seed the demo scenario automatically on first start (true/false).
AUTO_SEED=true

# Send the Secure flag on session cookies. Set true when served over HTTPS.
COOKIE_SECURE=false

# Comma-separated list of allowed CORS origins. Leave empty when the frontend is
# served from the same origin as the API (the default single-service deployment).
CORS_ORIGINS=

# Maximum upload size per file, in megabytes.
MAX_UPLOAD_MB=10

# Official-dashboard reporting period start (ISO date).
REPORTING_PERIOD_START=2026-07-01

# Port the backend listens on (hosts usually inject this).
PORT=5000

# Session lifetime in hours.
SESSION_HOURS=8

# ---- Frontend build-time (optional) ----
# Leave empty for same-origin API calls (recommended). Set only if the API is on
# a different origin than the static site.
VITE_API_BASE=
